{
  "schema": "dsh-comfy-suite/wardrobe@1",
  "version": 1,
  "title": "提示词衣柜",
  "description": "给 Qwen-Image 用的分层提示词池：段 → 字段 → 选项，每项带内容档位与权重。引擎按档位先收窄候选池，再按三层权重抽，同 seed 逐字可复现，并给出自检报告。风格/光效/构图/画质/负面五个段直接复用 qwen-presets.json，不重复维护。",
  "levels": [
    {
      "key": "sfw",
      "num": 0,
      "label": "全年龄",
      "hint": "可公开发布：无裸露、无性暗示、无血腥。"
    },
    {
      "key": "L1",
      "num": 1,
      "label": "轻度暗示",
      "hint": "泳装、内衣外穿、湿身、暧昧姿态；关键部位不裸露。"
    },
    {
      "key": "L2",
      "num": 2,
      "label": "明确",
      "hint": "裸露上身或下身、内衣/比基尼为主体的画面。"
    },
    {
      "key": "L3",
      "num": 3,
      "label": "露骨",
      "hint": "全裸、明确性行为姿态；仅限个人使用。"
    },
    {
      "key": "L4",
      "num": 4,
      "label": "极端",
      "hint": "极端姿势与强烈性张力；仅限个人使用。"
    }
  ],
  "modes": {
    "person": {
      "label": "人物",
      "hint": "人物 + 服装 + 动作 + 场景，默认模式。"
    },
    "object": {
      "label": "静物/主体",
      "hint": "不抽人物：主体 + 场景 + 镜头 + 光线 + 画风。"
    },
    "scene": {
      "label": "空镜",
      "hint": "只要环境：场景 + 镜头 + 光线 + 画风，画面里不出现人物。"
    }
  },
